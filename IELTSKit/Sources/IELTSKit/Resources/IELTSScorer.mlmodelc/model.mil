            tensor<fp16, [1, 1]> clip_0_cast_fp16 = clip(alpha = var_906_promoted_to_fp16, beta = const_0_to_fp16, x = var_905_cast_fp16)[name = tensor<string, []>("clip_0_cast_fp16")];
            tensor<fp16, [1, 768]> input_cast_fp16 = real_div(x = var_900_cast_fp16, y = clip_0_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp16, [5, 768]> scorer_head_weight_to_fp16 = const()[name = tensor<string, []>("scorer_head_weight_to_fp16"), val = tensor<fp16, [5, 768]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(130388288)))];
            tensor<fp16, [5]> scorer_head_bias_to_fp16 = const()[name = tensor<string, []>("scorer_head_bias_to_fp16"), val = tensor<fp16, [5]>([0x1.f54p-6, -0x1.2c4p-6, 0x1.ee4p-6, 0x1.11cp-6, -0x1.f9cp-6])];
            tensor<fp16, [1, 5]> linear_36_cast_fp16 = linear(bias = scorer_head_bias_to_fp16, weight = scorer_head_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("linear_36_cast_fp16")];
            tensor<fp16, []> var_913_promoted_to_fp16 = const()[name = tensor<string, []>("op_913_promoted_to_fp16"), val = tensor<fp16, []>(0x1.2p+3)];
            tensor<fp16, [1, 5]> bands = mul(x = linear_36_cast_fp16, y = var_913_promoted_to_fp16)[name = tensor<string, []>("op_914_cast_fp16")];
        } -> (bands);
}