            tensor<fp16, [768]> scorer_encoder_transformer_layer_5_ffn_lin2_bias_to_fp16 = const()[name = tensor<string, []>("scorer_encoder_transformer_layer_5_ffn_lin2_bias_to_fp16"), val = tensor<fp16, [768]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(130383488)))];
            tensor<fp16, [1, 512, 768]> linear_35_cast_fp16 = linear(bias = scorer_encoder_transformer_layer_5_ffn_lin2_bias_to_fp16, weight = scorer_encoder_transformer_layer_5_ffn_lin2_weight_to_fp16, x = input_73_cast_fp16)[name = tensor<string, []>("linear_35_cast_fp16")];
            tensor<fp16, [1, 512, 768]> input_75_cast_fp16 = add(x = linear_35_cast_fp16, y = input_71_cast_fp16)[name = tensor<string, []>("input_75_cast_fp16")];
            tensor<int32, [1]> x_axes_0 = const()[name = tensor<string, []>("x_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp16, [768]> scorer_encoder_transformer_layer_5_output_layer_norm_weight_to_fp16 = const()[name = tensor<string, []>("scorer_encoder_transformer_layer_5_output_layer_norm_weight_to_fp16"), val = tensor<fp16, [768]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(130385088)))];
            tensor<fp16, [768]> scorer_encoder_transformer_layer_5_output_layer_norm_bias_to_fp16 = const()[name = tensor<string, []>("scorer_encoder_transformer_layer_5_output_layer_norm_bias_to_fp16"), val = tensor<fp16, [768]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(130386688)))];
            tensor<fp16, []> var_887_to_fp16 = const()[name = tensor<string, []>("op_887_to_fp16"), val = tensor<fp16, []>(0x1p-24)];
            tensor<fp16, [1, 512, 768]> x_cast_fp16 = layer_norm(axes = x_axes_0, beta = scorer_encoder_transformer_layer_5_output_layer_norm_bias_to_fp16, epsilon = var_887_to_fp16, gamma = scorer_encoder_transformer_layer_5_output_layer_norm_weight_to_fp16, x = input_75_cast_fp16)[name = tensor<string, []>("x_cast_fp16")];
            tensor<int32, [1]> m_axes_0 = const()[name = tensor<string, []>("m_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp16, [1, 512, 1]> m_cast_fp16 = expand_dims(axes = m_axes_0, x = attention_mask_to_fp16)[name = tensor<string, []>("m_cast_fp16")];
            tensor<fp16, [1, 512, 768]> var_895_cast_fp16 = mul(x = x_cast_fp16, y = m_cast_fp16)[name = tensor<string, []>("op_895_cast_fp16")];
            tensor<int32, [1]> var_900_axes_0 = const()[name = tensor<string, []>("op_900_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<bool, []> var_900_keep_dims_0 = const()[name = tensor<string, []>("op_900_keep_dims_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 768]> var_900_cast_fp16 = reduce_sum(axes = var_900_axes_0, keep_dims = var_900_keep_dims_0, x = var_895_cast_fp16)[name = tensor<string, []>("op_900_cast_fp16")];
            tensor<int32, [1]> var_905_axes_0 = const()[name = tensor<string, []>("op_905_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<bool, []> var_905_keep_dims_0 = const()[name = tensor<string, []>("op_905_keep_dims_0"), val = tensor<bool, []>(false)];
            tensor<fp16, [1, 1]> var_905_cast_fp16 = reduce_sum(axes = var_905_axes_0, keep_dims = var_905_keep_dims_0, x = m_cast_fp16)[name = tensor<string, []>("op_905_cast_fp16")];
            tensor<fp16, []> var_906_promoted_to_fp16 = const()[name = tensor<string, []>("op_906_promoted_to_fp16"), val = tensor<fp16, []>(0x1p+0)];
